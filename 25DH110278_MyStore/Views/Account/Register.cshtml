﻿@model _25DH110278_MyStore.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top: 25px;">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-primary" style="border-radius: 8px;">
            <div class="panel-heading text-center" style="font-size: 18px; font-weight: bold;">
                ĐĂNG KÝ TÀI KHOẢN KHÁCH HÀNG
            </div>
            <div class="panel-body" style="padding: 25px;">
                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        <label>Tên đăng nhập (*)</label>
                        @Html.EditorFor(m => m.Username, new { htmlAttributes = new { @class = "form-control", placeholder = "Tên đăng nhập..." } })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Mật khẩu (*)</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu..." })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Xác nhận mật khẩu (*)</label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu..." })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>

                    <hr />

                    <div class="form-group">
                        <label>Họ và tên (*)</label>
                        @Html.EditorFor(m => m.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = "Họ tên của bạn..." } })
                        @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Số điện thoại (*)</label>
                        @Html.EditorFor(m => m.CustomerPhone, new { htmlAttributes = new { @class = "form-control", placeholder = "Số điện thoại..." } })
                        @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Email (*)</label>
                        @Html.EditorFor(m => m.CustomerEmail, new { htmlAttributes = new { @class = "form-control", placeholder = "Địa chỉ email..." } })
                        @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ (*)</label>
                        @Html.EditorFor(m => m.CustomerAddress, new { htmlAttributes = new { @class = "form-control", placeholder = "Địa chỉ nhận hàng..." } })
                        @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 20px;">
                        ĐĂNG KÝ
                    </button>
                    <p class="text-center" style="margin-top: 15px;">
                        Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập tại đây</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>
