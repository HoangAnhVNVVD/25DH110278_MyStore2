﻿@model _25DH110278_MyStore.Models.ViewModel.ChangePasswordVM

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top: 25px;">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-warning" style="border-radius: 8px;">
            <div class="panel-heading" style="font-size: 18px; font-weight: bold;">
                ĐỔI MẬT KHẨU
            </div>
            <div class="panel-body" style="padding: 25px;">
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        <label>Mật khẩu hiện tại (*)</label>
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", placeholder = "Nhập mật khẩu hiện tại..." })
                        @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Mật khẩu mới (*)</label>
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Nhập mật khẩu mới..." })
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Xác nhận mật khẩu mới (*)</label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới..." })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-warning btn-block btn-lg" style="margin-top: 20px;">
                        CẬP NHẬT MẬT KHẨU
                    </button>
                    <a href="@Url.Action("ProfileInfo", "Account")" class="btn btn-default btn-block" style="margin-top: 10px;">
                        Quay lại hồ sơ
                    </a>
                }
            </div>
        </div>
    </div>
</div>
