﻿@model _25DH110278_MyStore.Models.ViewModel.LoginVM

@{
    ViewBag.Title = "Đăng nhập hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top: 35px;">
    <div class="col-md-4 col-md-offset-4">
        <div class="panel panel-primary" style="border-radius: 8px;">
            <div class="panel-heading text-center" style="font-size: 18px; font-weight: bold;">
                ĐĂNG NHẬP
            </div>
            <div class="panel-body" style="padding: 25px;">
                @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        <label>Tên đăng nhập</label>
                        @Html.EditorFor(m => m.Username, new { htmlAttributes = new { @class = "form-control", placeholder = "Username...", autofocus = "autofocus" } })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Mật khẩu</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu..." })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 20px;">
                        ĐĂNG NHẬP
                    </button>

                    <div class="text-center" style="margin-top: 15px;">
                        Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
