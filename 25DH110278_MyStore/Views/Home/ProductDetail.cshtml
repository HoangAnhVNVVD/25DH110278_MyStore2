@model _25DH110278_MyStore.Models.ViewModel.ProductDetailVM

@{
    ViewBag.Title = Model.Product.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default" style="border-radius: 8px; margin-top: 15px;">
    <div class="panel-body" style="padding: 30px;">
        <div class="row">
            <div class="col-md-5 text-center">
                @if (!string.IsNullOrEmpty(Model.Product.ProductImage))
                {
                    var imgSrc = (Model.Product.ProductImage.StartsWith("~") || Model.Product.ProductImage.StartsWith("/")) ? Model.Product.ProductImage : "~/Content/images/" + Model.Product.ProductImage;
                    <img src="@Url.Content(imgSrc)" alt="@Model.Product.ProductName" class="img-responsive img-thumbnail" style="max-height: 380px; width: 100%; object-fit: contain;" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default_img.png")';" />
                }
                else
                {
                    <img src="@Url.Content("~/Content/images/default_img.png")" alt="Default" class="img-responsive img-thumbnail" style="max-height: 380px; width: 100%; object-fit: contain;" />
                }
            </div>
            <div class="col-md-7">
                <h2 style="font-weight: bold; color: #2c3e50; margin-top: 0;">@Model.Product.ProductName</h2>
                <p>
                    <span class="label label-info" style="font-size: 13px;">@(Model.Product.Category != null ? Model.Product.Category.CategoryName : "Chưa phân loại")</span>
                </p>
                <div style="background-color: #fff9f8; border: 1px solid #ffded9; padding: 15px 20px; border-radius: 6px; margin: 20px 0;">
                    <span style="font-size: 15px; color: #7f8c8d;">Giá bán:</span>
                    <span style="font-size: 28px; font-weight: bold; color: #e74c3c; margin-left: 10px;">
                        @Model.Product.ProductPrice.ToString("N0") VNĐ
                    </span>
                </div>

                <h4>Thông tin mô tả:</h4>
                <div style="font-size: 15px; line-height: 1.6; color: #555; white-space: pre-line; margin-bottom: 25px;">
                    @Model.Product.ProductDescription
                </div>

                <div style="margin-bottom: 20px;">
                    @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Get, new { @class = "form-inline" }))
                    {
                        <input type="hidden" name="id" value="@Model.Product.ProductID" />
                        <div class="form-group" style="margin-right: 15px;">
                            <label style="margin-right: 8px;">Số lượng: </label>
                            <input type="number" name="quantity" value="1" min="1" max="99" class="form-control text-center" style="width: 70px;" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg" style="margin-right: 10px;">
                            <i class="glyphicon glyphicon-shopping-cart"></i> Thêm vào giỏ hàng
                        </button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-default btn-lg">
                            ← Tiếp tục xem
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    @Html.Partial("_PVRelatedProduct", Model.RelatedProducts)
}

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    @Html.Partial("_PVTopProduct", Model.TopProducts)
}
