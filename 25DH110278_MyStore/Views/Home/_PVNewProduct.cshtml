@model PagedList.IPagedList<_25DH110278_MyStore.Models.Product>
@using PagedList.Mvc;

<div class="panel panel-default" style="border-radius: 8px;">
    <div class="panel-heading" style="font-weight: bold; font-size: 16px; background-color: #f1f2f6;">
        <i class="glyphicon glyphicon-star"></i> DANH SÁCH SẢN PHẨM MỚI NHẤT
    </div>
    <div class="panel-body">
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="product-card">
                            <div class="product-img-box">
                                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        var imgSrc = (item.ProductImage.StartsWith("~") || item.ProductImage.StartsWith("/")) ? item.ProductImage : "~/Content/images/" + item.ProductImage;
                                        <img src="@Url.Content(imgSrc)" alt="@item.ProductName" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default_img.png")';" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/Content/images/default_img.png")" alt="Default" />
                                    }
                                </a>
                            </div>
                            <div class="product-body">
                                <div class="product-title" title="@item.ProductName">
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" style="color: #2c3e50; text-decoration: none;">
                                        @item.ProductName
                                    </a>
                                </div>
                                <div class="product-price">
                                    @item.ProductPrice.ToString("N0") đ
                                </div>
                                <div class="row">
                                    <div class="col-xs-6" style="padding-right: 3px;">
                                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-default btn-block btn-sm">
                                            Chi tiết
                                        </a>
                                    </div>
                                    <div class="col-xs-6" style="padding-left: 3px;">
                                        <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-primary btn-block btn-sm">
                                            + Giỏ
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="text-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm, categoryId = ViewBag.CategoryID }))
        </div>
    </div>
</div>
