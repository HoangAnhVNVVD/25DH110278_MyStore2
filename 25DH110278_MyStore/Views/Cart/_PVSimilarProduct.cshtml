﻿@model PagedList.IPagedList<_25DH110278_MyStore.Models.Product>

@if (Model != null && Model.Any())
{
    <div class="panel panel-default" style="border-radius: 8px; margin-top: 25px;">
        <div class="panel-heading" style="font-weight: bold; font-size: 16px;">
            <i class="glyphicon glyphicon-gift"></i> CÓ THỂ BẠN CŨNG THÍCH (SẢN PHẨM TƯƠNG TỰ)
        </div>
        <div class="panel-body">
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="product-card">
                            <div class="product-img-box">
                                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/Content/images/default_img.png")" alt="Default" />
                                    }
                                </a>
                            </div>
                            <div class="product-body">
                                <div class="product-title" title="@item.ProductName">
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" style="color: #2c3e50; text-decoration: none;">
                                        @item.ProductName
                                    </a>
                                </div>
                                <div class="product-price">
                                    @item.ProductPrice.ToString("N0") đ
                                </div>
                                <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-default btn-block btn-sm">
                                    + Thêm vào giỏ
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
