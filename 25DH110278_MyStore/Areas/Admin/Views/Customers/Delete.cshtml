﻿@model _25DH110278_MyStore.Models.Customer

@{
    ViewBag.Title = "Xóa Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">XÁC NHẬN XÓA KHÁCH HÀNG</h3>
    </div>
    <div class="panel-body">
        <h4 class="text-danger">Bạn có chắc chắn muốn xóa thông tin khách hàng này khỏi hệ thống?</h4>
        <dl class="dl-horizontal">
            <dt>Mã khách hàng</dt>
            <dd>@Model.CustomerID</dd>

            <dt>Tên khách hàng</dt>
            <dd><strong>@Model.CustomerName</strong></dd>

            <dt>Số điện thoại</dt>
            <dd>@Model.CustomerPhone</dd>

            <dt>Email</dt>
            <dd>@Model.CustomerEmail</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions no-color">
                <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
                @Html.ActionLink("Hủy bỏ và quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
