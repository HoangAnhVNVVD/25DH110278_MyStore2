﻿@model PagedList.IPagedList<_25DH110278_MyStore.Models.Customer>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Quản lý Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 class="panel-title" style="font-size: 18px;">DANH SÁCH KHÁCH HÀNG</h3>
    </div>
    <div class="panel-body">
        <div class="well well-sm">
            @using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="form-group" style="margin-right: 10px;">
                    <label>Tìm kiếm: </label>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Họ tên, SĐT, Email, Username..." style="width: 300px;" />
                </div>
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                @Html.ActionLink("Đặt lại", "Index", null, new { @class = "btn btn-default" })
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr class="info">
                        <th style="width: 70px;">Mã KH</th>
                        <th>Họ tên khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Địa chỉ</th>
                        <th>Tài khoản</th>
                        <th style="width: 100px; text-align: center;">Số đơn hàng</th>
                        <th style="width: 180px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CustomerID</td>
                                <td><strong>@item.CustomerName</strong></td>
                                <td>@item.CustomerPhone</td>
                                <td>@item.CustomerEmail</td>
                                <td>@item.CustomerAddress</td>
                                <td><span class="label label-info">@item.Username</span></td>
                                <td style="text-align: center;"><span class="badge">@(item.Orders != null ? item.Orders.Count : 0)</span></td>
                                <td style="text-align: center;">
                                    @Html.ActionLink("Xem", "Details", new { id = item.CustomerID }, new { @class = "btn btn-info btn-xs" })
                                    @Html.ActionLink("Sửa", "Edit", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-xs" })
                                    @Html.ActionLink("Xóa", "Delete", new { id = item.CustomerID }, new { @class = "btn btn-danger btn-xs" })
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted" style="padding: 20px;">
                                Không tìm thấy khách hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">
            <div class="col-md-6" style="padding-top: 15px;">
                Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount (Tổng số @Model.TotalItemCount khách hàng)
            </div>
            <div class="col-md-6 text-right">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm }))
            </div>
        </div>
    </div>
</div>
