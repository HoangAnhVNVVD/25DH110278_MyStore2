﻿@model _25DH110278_MyStore.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-info">
    <div class="panel-heading">
        <h3 class="panel-title">CHI TIẾT SẢN PHẨM</h3>
    </div>
    <div class="panel-body">
        @Html.Partial("PVProductInfo", Model)
        <hr />
        <p>
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </p>
    </div>
</div>
