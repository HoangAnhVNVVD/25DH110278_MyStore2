﻿@model _25DH110278_MyStore.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">XÁC NHẬN XÓA SẢN PHẨM</h3>
    </div>
    <div class="panel-body">
        <h4 class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này?</h4>
        <hr />
        @Html.Partial("PVProductInfo", Model)
        <hr />
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions no-color">
                <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
                @Html.ActionLink("Hủy bỏ và quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
