﻿@model _25DH110278_MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Quản lý Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 class="panel-title" style="font-size: 18px;">QUẢN LÝ SẢN PHẨM</h3>
    </div>
    <div class="panel-body">
        <div class="well well-sm">
            @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="form-group" style="margin-right: 10px; margin-bottom: 10px;">
                    <label>Từ khóa: </label>
                    @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tên, mô tả, danh mục..." })
                </div>

                <div class="form-group" style="margin-right: 10px; margin-bottom: 10px;">
                    <label>Giá từ: </label>
                    @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", type = "number", placeholder = "Tối thiểu", style = "width: 120px;" })
                </div>

                <div class="form-group" style="margin-right: 10px; margin-bottom: 10px;">
                    <label>đến: </label>
                    @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", type = "number", placeholder = "Tối đa", style = "width: 120px;" })
                </div>

                <div class="form-group" style="margin-right: 10px; margin-bottom: 10px;">
                    <label>Sắp xếp: </label>
                    @Html.DropDownListFor(m => m.SortOrder, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Tên: A -> Z", Value = "name_asc" },
                        new SelectListItem { Text = "Tên: Z -> A", Value = "name_desc" },
                        new SelectListItem { Text = "Giá: Thấp đến Cao", Value = "price_asc" },
                        new SelectListItem { Text = "Giá: Cao đến Thấp", Value = "price_desc" }
                    }, new { @class = "form-control" })
                </div>

                <div class="form-group" style="margin-bottom: 10px;">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    @Html.ActionLink("Đặt lại", "Index", null, new { @class = "btn btn-default" })
                    @Html.ActionLink("Thêm mới sản phẩm", "Create", null, new { @class = "btn btn-success", style = "margin-left: 15px;" })
                </div>
            }
        </div>

        @Html.Partial("PVListProduct", Model)
    </div>
</div>
