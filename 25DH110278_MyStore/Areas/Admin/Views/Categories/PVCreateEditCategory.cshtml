﻿@model _25DH110278_MyStore.Models.Category

<div class="form-group">
    <label class="control-label col-md-2">Tên danh mục</label>
    <div class="col-md-8">
        @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục..." } })
        @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-8">
        <input type="submit" value="Lưu dữ liệu" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
    </div>
</div>
