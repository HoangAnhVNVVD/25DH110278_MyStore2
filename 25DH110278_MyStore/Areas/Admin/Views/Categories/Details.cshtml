﻿@model _25DH110278_MyStore.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-info">
    <div class="panel-heading">
        <h3 class="panel-title">CHI TIẾT DANH MỤC</h3>
    </div>
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Mã danh mục</dt>
            <dd>@Model.CategoryID</dd>

            <dt>Tên danh mục</dt>
            <dd><strong>@Model.CategoryName</strong></dd>

            <dt>Số sản phẩm</dt>
            <dd>@(Model.Products != null ? Model.Products.Count : 0) sản phẩm</dd>
        </dl>
        <hr />
        <p>
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </p>
    </div>
</div>
