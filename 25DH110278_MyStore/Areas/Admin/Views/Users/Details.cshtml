﻿@model _25DH110278_MyStore.Models.User

@{
    ViewBag.Title = "Chi tiết Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-info">
    <div class="panel-heading">
        <h3 class="panel-title">CHI TIẾT TÀI KHOẢN</h3>
    </div>
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Tên đăng nhập</dt>
            <dd><strong>@Model.Username</strong></dd>

            <dt>Vai trò</dt>
            <dd>
                @if (Model.UserRole == "A" || Model.UserRole == "Admin")
                {
                    <span class="label label-danger">Quản trị viên</span>
                }
                else
                {
                    <span class="label label-primary">Khách hàng</span>
                }
            </dd>

            <dt>Khách hàng liên kết</dt>
            <dd>
                @(Model.Customers != null && Model.Customers.Any() ? Model.Customers.First().CustomerName : "Không có")
            </dd>
        </dl>
        <hr />
        <p>
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.Username }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </p>
    </div>
</div>
