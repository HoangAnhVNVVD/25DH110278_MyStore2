﻿@model _25DH110278_MyStore.Models.User

@{
    ViewBag.Title = "Xóa Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">XÁC NHẬN XÓA TÀI KHOẢN</h3>
    </div>
    <div class="panel-body">
        <h4 class="text-danger">Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống?</h4>
        <dl class="dl-horizontal">
            <dt>Tên đăng nhập</dt>
            <dd><strong>@Model.Username</strong></dd>

            <dt>Vai trò</dt>
            <dd>@Model.UserRole</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions no-color">
                <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
                @Html.ActionLink("Hủy bỏ và quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
