﻿@model _25DH110278_MyStore.Models.User

@{
    ViewBag.Title = "Thêm tài khoản mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 class="panel-title">THÊM TÀI KHOẢN MỚI</h3>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    <label class="control-label col-md-2">Tên đăng nhập</label>
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập username..." } })
                        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-2">Mật khẩu</label>
                    <div class="col-md-8">
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu..." })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-2">Vai trò</label>
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.UserRole, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Quản trị viên (Admin)", Value = "A" },
                            new SelectListItem { Text = "Khách hàng (Customer)", Value = "C" }
                        }, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.UserRole, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-8">
                        <input type="submit" value="Tạo tài khoản" class="btn btn-primary" />
                        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>
