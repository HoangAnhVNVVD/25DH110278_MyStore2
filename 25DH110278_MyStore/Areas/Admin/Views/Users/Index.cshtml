﻿@model PagedList.IPagedList<_25DH110278_MyStore.Models.User>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Quản lý Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 class="panel-title" style="font-size: 18px;">DANH SÁCH TÀI KHOẢN HỆ THỐNG</h3>
    </div>
    <div class="panel-body">
        <div class="well well-sm">
            @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="form-group" style="margin-right: 10px;">
                    <label>Tìm kiếm: </label>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tên đăng nhập, vai trò..." style="width: 250px;" />
                </div>
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                @Html.ActionLink("Đặt lại", "Index", null, new { @class = "btn btn-default" })
                @Html.ActionLink("Thêm tài khoản mới", "Create", null, new { @class = "btn btn-success", style = "margin-left: 15px;" })
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr class="info">
                        <th>Tên đăng nhập</th>
                        <th>Vai trò (Role)</th>
                        <th style="width: 150px; text-align: center;">Thông tin khách hàng</th>
                        <th style="width: 200px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Username</strong></td>
                                <td>
                                    @if (item.UserRole == "A" || item.UserRole == "Admin")
                                    {
                                        <span class="label label-danger">Quản trị viên (Admin)</span>
                                    }
                                    else
                                    {
                                        <span class="label label-primary">Khách hàng (Customer)</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @(item.Customers != null && item.Customers.Any() ? item.Customers.First().CustomerName : "Chưa liên kết")
                                </td>
                                <td style="text-align: center;">
                                    @Html.ActionLink("Xem", "Details", new { id = item.Username }, new { @class = "btn btn-info btn-xs" })
                                    @Html.ActionLink("Sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-primary btn-xs" })
                                    @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-danger btn-xs" })
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted" style="padding: 20px;">
                                Không tìm thấy tài khoản nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">
            <div class="col-md-6" style="padding-top: 15px;">
                Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount (Tổng số @Model.TotalItemCount tài khoản)
            </div>
            <div class="col-md-6 text-right">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm }))
            </div>
        </div>
    </div>
</div>
